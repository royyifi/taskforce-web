# Database (local dev: file:./dev.db — production: Turso libsql:// URL)
DATABASE_URL="file:./dev.db"

# Required in production (Turso)
# DATABASE_URL="libsql://<your-db>-<your-org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso token>"

# Auth session secret (generate: openssl rand -base64 32)

# Cloudinary (production file storage — free tier: 25GB)
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AUTH_SECRET=""