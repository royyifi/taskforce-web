# Database (local dev: file:./dev.db — production: Turso libsql:// URL)
DATABASE_URL="file:./dev.db"

# Required in production (Turso)
# DATABASE_URL="libsql://<your-db>-<your-org>.turso.io"
# DATABASE_AUTH_TOKEN="<turso token>"

# Auth session secret (generate: openssl rand -base64 32)

# Cloudflare R2 (production file storage)
# R2_PUBLIC_URL should be the bucket's public URL or a custom domain, e.g. https://files.example.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
AUTH_SECRET=""